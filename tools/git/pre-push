#!/usr/bin/env bash
# Chặn push force/non-fast-forward; máy B chặn push thẳng lên main.
ROLE="$(git config --local fittrack.role || true)"
[[ -z "$ROLE" ]] && exit 0
ZERO="0000000000000000000000000000000000000000"
while read -r lref lsha rref rsha; do
  [[ "$lsha" == "$ZERO" ]] && continue                       # xóa nhánh: bỏ qua
  if [[ "$rref" == "refs/heads/main" ]]; then
    echo "✖ Không push thẳng lên main. Hãy push nhánh feature và mở Pull Request."; exit 1
  fi
  if [[ "$rsha" != "$ZERO" ]] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
    echo "✖ Push không phải fast-forward (force/rewrite) lên $rref. Bị chặn."; exit 1
  fi
done
exit 0
